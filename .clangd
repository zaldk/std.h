Diagnostics:
  Suppress:
    - macro-redefined
    - unused-includes
    - overlength-strings
    - c99-extensions
    - variadic-macros
Index:
  StandardLibrary: No
CompileFlags:
  Add: [
    -xc,
    # -std=c89,
    -pedantic,
    -Wno-empty-translation-unit,
    -Wno-dollar-in-identifier-extension,
    -DSTD_IMPLEMENTATION,
    -DSTD_LINUX_IMPLEMENTATION,
    -DSTD_COMMON_IMPLEMENTATION,
  ]